// Resources of VetusPoeta.exe (configured by gui/shell/CMakeLists.txt).
#include <winresrc.h>

1 ICON "@VP_ICON_PATH@"
// MinGW embeds the manifest here; MSVC gets it through the linker (/MANIFESTINPUT), which merges it
// into the one the linker generates instead of silently replacing it.
#ifdef VP_RC_EMBED_MANIFEST
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@VP_MANIFEST_PATH@"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VP_VER_MAJOR@,@VP_VER_MINOR@,@VP_VER_PATCH@,0
 PRODUCTVERSION @VP_VER_MAJOR@,@VP_VER_MINOR@,@VP_VER_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "vetus poeta"
      VALUE "FileDescription", "vetus poeta - Latin and Greek subtitles and texts"
      VALUE "FileVersion", "@VP_VER_STRING@"
      VALUE "InternalName", "VetusPoeta"
      VALUE "OriginalFilename", "VetusPoeta.exe"
      VALUE "ProductName", "vetus poeta"
      VALUE "ProductVersion", "@VP_VER_STRING@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
